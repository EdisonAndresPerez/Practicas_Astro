---
import LoginGithubButton from '../components/button/LoginGithubButton';
import AuthLayout from '../layouts/AuthLayout.astro'
---

<AuthLayout>
  <div class='w-full lg:w-1/2 flex items-center justify-center p-8 bg-white'>
    <div class='w-full max-w-md'>
      <div class='mb-10'>
        <h1 class='text-4xl font-bold text-slate-900 mb-2'>Registrar Cuenta</h1>
        <p class='text-slate-600'>Ingresa tus credenciales para registrarte</p>
      </div>

      <form action='#' method='POST' class='space-y-6'>
        
        <div class='flex space-x-4'>
          {/*Nombre para el formulario */}
          <div class='w-1/2'>
            <label
              for='name'
              class='block text-sm font-medium text-slate-700 mb-2'
            >
              Nombre
            </label>
            <input
              type='text'
              id='name'
              name='name'
              class='w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-200 bg-slate-50 hover:bg-white'
              autocomplete='off'
              placeholder='Ingresa tu nombre'
            />
          </div>

          {/*Apellido para el formulario */}
          <div class='w-1/2'>
            <label
              for='lastName'
              class='block text-sm font-medium text-slate-700 mb-2'
            >
              Apellido
            </label>
            <input
              type='text'
              id='lastName'
              name='lastName'
              class='w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-200 bg-slate-50 hover:bg-white'
              autocomplete='off'
              placeholder='Ingresa tu apellido'
            />
          </div>
        </div>

        {/*Correo para el formulario */}
        <div>
          <label
            for='email'
            class='block text-sm font-medium text-slate-700 mb-2'
          >
            Correo Electronico
          </label>
          <input
            type='email'
            id='email'
            name='email'
            class='w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200 bg-slate-50 hover:bg-white'
            autocomplete='off'
            placeholder='Ingresa tu correo electronico'
          />
        </div>

        {/*Username para el formulario */}
        <div>
          <label
            for='user'
            class='block text-sm font-medium text-slate-700 mb-2'
          >
            Usuario
          </label>
          <input
            type='text'
            id='user'
            name='user'
            class='w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200 bg-slate-50 hover:bg-white'
            autocomplete='off'
            placeholder='Ingresa tu usuario'
          />
        </div>

        {/*Password para el formulario */}
        <div>
          <label
            for='password'
            class='block text-sm font-medium text-slate-700 mb-2'
          >
            Contraseña
          </label>
          <input
            type='password'
            id='password'
            name='password'
            class='w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all duration-200 bg-slate-50 hover:bg-white'
            autocomplete='off'
            placeholder='Ingresa tu contraseña'
          />
        </div>




        <div class='flex items-center justify-between'></div>
        <button
          type='submit'
          id='btn-submit'
          class='disabled w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-lg py-3.5 px-4 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5'
        >
          Crear Cuenta
        </button>
      </form>
      <div class='mt-8 text-center'>
        <p class='text-slate-600'>
          ¿Ya tienes cuenta?
          <a
            href='/login'
            class='font-semibold text-slate-900 hover:text-slate-700 transition-colors ml-1'
          >
            Inicia sesión aquí
          </a>
        </p>
      </div>
      <div class='mt-8 flex items-center'>
        <div class='flex-1 border-t border-slate-300'></div>
        <span class='px-4 text-sm text-slate-500'>O Registrate con</span>
        <div class='flex-1 border-t border-slate-300'></div>
      </div>

      <div class='mt-6 grid grid-cols-2 gap-4'>
        <button
          class='flex items-center justify-center px-4 py-3 border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors'
        >
          <svg class='w-5 h-5 mr-2' viewBox='0 0 24 24'>
            <path
              fill='#4285F4'
              d='M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z'
            ></path>
            <path
              fill='#34A853'
              d='M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z'
            ></path>
            <path
              fill='#FBBC05'
              d='M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z'
            ></path>
            <path
              fill='#EA4335'
              d='M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z'
            ></path>
          </svg>
          <span class='text-sm font-medium text-slate-700'>Google</span>
        </button>

        {/*buton de github */}
        <LoginGithubButton client:load />







      </div>



    </div>
  </div>
</AuthLayout>

<style>
  /* Custom focus styles for better accessibility */
  input:focus {
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
  }

  /* Smooth transitions */
  * {
    transition-property: background-color, border-color, color, fill, stroke,
      opacity, box-shadow, transform;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

<script>
  import { getAuth, createUserWithEmailAndPassword, updateProfile } from 'firebase/auth'
  import { firebase } from '../firebase/config'
  import { actions } from 'astro:actions'

  const form = document.querySelector('form') as HTMLFormElement
  const btnSubmit = document.querySelector('#btn-submit') as HTMLButtonElement
  const auth = firebase.auth

  form.addEventListener('submit', async e => {
    e.preventDefault()
    btnSubmit.setAttribute('disabled', 'disabled')
    btnSubmit.textContent = 'Creando cuenta...'

    const formData = new FormData(form)
    
    // Primero validamos con Astro Actions
    const { data, error } = await actions.register(formData)
    
    if (error) {
      console.log('Error de validación:', error.message)
      btnSubmit.removeAttribute('disabled')
      btnSubmit.textContent = 'Crear Cuenta'
      return
    }

    // Si la validación es exitosa, creamos el usuario con Firebase
    try {
      const email = formData.get('email') as string
      const password = formData.get('password') as string
      const name = formData.get('name') as string
      const lastName = formData.get('lastName') as string

      // Crear usuario en Firebase
      const userCredential = await createUserWithEmailAndPassword(auth, email, password)
      const user = userCredential.user

      // Actualizar el perfil con nombre y apellido
      await updateProfile(user, {
        displayName: `${name} ${lastName}`
      })

      console.log('Usuario creado exitosamente:', user)
      alert('¡Cuenta creada exitosamente!')
      
      // Redirigir al login o dashboard
      // window.location.href = '/login'
      
    } catch (firebaseError: any) {
      console.error('Error de Firebase:', firebaseError)
      
      let errorMessage = 'Error al crear la cuenta'
      if (firebaseError.code === 'auth/email-already-in-use') {
        errorMessage = 'Este correo ya está registrado'
      } else if (firebaseError.code === 'auth/weak-password') {
        errorMessage = 'La contraseña es muy débil'
      }
      
      alert(errorMessage)
    }

    btnSubmit.removeAttribute('disabled')
    btnSubmit.textContent = 'Crear Cuenta'
  })
</script>
