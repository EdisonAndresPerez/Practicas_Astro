---
import Navbar from '../components/navbar/Navbar.astro'
import '../styles/global.css'

interface Props {
  title?: string
}
const { title = ' Autenticación Firebase con Astro' } = Astro.props
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <main class="container m-auto max-w-3xl px-5">
      <slot />
    </main>
  </body>
</html>
